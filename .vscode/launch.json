{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Text Extractor",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "GROQ_API_KEY": "${env:GROQ_API_KEY}"
      }
    }
  ]
}
