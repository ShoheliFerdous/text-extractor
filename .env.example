# Settings reference — set these as environment variables in your terminal. All optional.

# AI vision model (any OpenAI-compatible API). Leave the key empty to use offline OCR only.
GROQ_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# For OpenAI instead of Groq:
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# auto = AI if a key is set, else Tesseract | ai | tesseract
OCR_ENGINE=auto
TESSERACT_LANG=eng
MAX_UPLOAD_MB=25
MAX_PAGES=100
